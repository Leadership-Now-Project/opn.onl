# Copy to .env on the server (mode 600). Never commit .env.

# Image tag published by .github/workflows/lnp-images.yml, e.g. lnp-1.9.0-1
OPN_TAG=

# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 64
JWT_SECRET=

# Cloudflare Zero Trust: https://<team>.cloudflareaccess.com and the AUD tag of
# the Access application for links.leadershipnowproject.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional: MaxMind GeoLite2 for click locations
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Optional: off-server database backups (S3-compatible)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
