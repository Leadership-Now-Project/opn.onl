# Copy to .env on the server (mode 600). Never commit .env.

# Image tag published by .github/workflows/lnp-images.yml, e.g. lnp-1.9.0-1
OPN_TAG=
# Optional: the Claude connector's image tag, when it differs from OPN_TAG.
OPN_MCP_TAG=

# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 64
JWT_SECRET=

# Dashboard sign-in with Google. The OAuth 2.0 Web client in the Google Cloud
# project lnp-links (README, "Google sign-in"). Both blank = no Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Email domains that may sign in; the default is
# leadershipnowproject.com,leadershipnowproject.org
GOOGLE_ALLOWED_DOMAINS=
# Optional, default true: the account must be a Google Workspace account of
# one of the allowed domains (the token's hd claim). Leave it alone unless
# staff with an allowed address are refused.
GOOGLE_REQUIRE_HD=

# The shared organization (README, "Shared links"). Every staff account joins
# it at sign-in and its links are listed under "All LNP Links". Name or slug
# blank = off. The slug identifies the organization: do not change it once
# people have signed in, or a second, empty organization is created.
DEFAULT_ORG_NAME=Leadership Now Project
DEFAULT_ORG_SLUG=lnp
# Comma-separated addresses that are organization admins (may delete any
# link, manage members). Applied when each signs in; removing an address
# does not demote anyone, use the Teams page for that.
DEFAULT_ORG_ADMINS=jay.shapiro@leadershipnowproject.com,marie@leadershipnowproject.com,dan.mathis@leadershipnowproject.com

# The Claude connector's sign-in. Cloudflare Zero Trust:
# https://<team>.cloudflareaccess.com and the AUD tag of the Access application
# for links-mcp.leadershipnowproject.com (the connector, not the dashboard).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional: MaxMind GeoLite2 for click locations
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Optional: off-server database backups (S3-compatible)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Optional: file sharing (README, "File sharing"). A private S3 bucket of its
# own, never the backup bucket. Bucket blank = the Files tab says file sharing
# is not set up, and nothing else changes.
FILES_S3_BUCKET=
# Default us-east-2.
FILES_S3_REGION=
# Only for an S3-compatible service that is not AWS. Leave blank for AWS.
FILES_S3_ENDPOINT=
# An IAM user's key pair with the policy in the README. Leave BOTH blank to
# use the server's own AWS credentials (an EC2 instance role).
FILES_S3_ACCESS_KEY=
FILES_S3_SECRET_KEY=
# Largest file accepted, in bytes. Default 524288000 (500 MB).
FILES_MAX_BYTES=
# How long the browser has to send a file once it has started (default 900
# seconds), and how long a visitor's download address works (default 300).
FILES_UPLOAD_URL_TTL_SECS=
FILES_DOWNLOAD_URL_TTL_SECS=
# Secure View (README, "Secure View"): the largest PDF, in bytes, that gets a
# "no printing, no copying" copy. Default 52428800 (50 MB). A larger PDF is
# shown in the viewer from the original.
SECURE_VIEW_PROTECT_MAX_BYTES=
# The memory budget, in bytes, of making that copy. Default 268435456
# (256 MB). A PDF that would need more gets no copy and is shown from the
# original. Raise it together with the limit above, not instead of it.
SECURE_VIEW_PROTECT_BUDGET_BYTES=

# Optional: "Google Drive Files" on the Files tab (README, "Google Drive
# picker"). Needs Google sign-in above. Either blank = the button says it is
# not set up, and nothing else changes.
# A browser API key from the Google Cloud project lnp-links, restricted to the
# Google Picker API and to the referrer https://links.leadershipnowproject.com/*
# It is sent to every signed-in browser, so it is not a secret; the
# restrictions are what protect it.
GOOGLE_PICKER_API_KEY=
# The Google Cloud project's number (not its name or id).
GOOGLE_PICKER_APP_ID=

# Optional, default false. Personal API keys (opn_...) work from anywhere and
# outlive a suspended Google account; the Claude connector does not use them.
ENABLE_API_KEYS=
