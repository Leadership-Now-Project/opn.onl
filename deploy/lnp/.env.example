# Copy to .env on the server (mode 600). Never commit .env.

# Image tag published by .github/workflows/lnp-images.yml, e.g. lnp-1.9.0-1
OPN_TAG=
# Optional: the Claude connector's image tag, when it differs from OPN_TAG.
OPN_MCP_TAG=

# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 64
JWT_SECRET=

# Dashboard sign-in with Google. The OAuth 2.0 Web client in the Google Cloud
# project lnp-links (README, "Google sign-in"). Both blank = no Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Email domains that may sign in; the default is
# leadershipnowproject.com,leadershipnowproject.org
GOOGLE_ALLOWED_DOMAINS=
# Optional, default true: the account must be a Google Workspace account of
# one of the allowed domains (the token's hd claim). Leave it alone unless
# staff with an allowed address are refused.
GOOGLE_REQUIRE_HD=

# The Claude connector's sign-in. Cloudflare Zero Trust:
# https://<team>.cloudflareaccess.com and the AUD tag of the Access application
# for links-mcp.leadershipnowproject.com (the connector, not the dashboard).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional: MaxMind GeoLite2 for click locations
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Optional: off-server database backups (S3-compatible)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
